generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  member
}

enum SubscriptionPlan {
  free
  starter
  basic
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  inactive
}

enum BillingCycle {
  monthly
  yearly
}

enum AccountType {
  pf
  pj
}

enum TransactionType {
  income
  expense
}

enum EntityType {
  pf
  pj
}

enum IntegrationType {
  whatsapp
}

enum IntegrationStatus {
  disabled
  active
}

enum WhatsappMessageDirection {
  inbound
  outbound
}

enum WhatsappMessageType {
  text
  audio
  image
}

enum SmartDraftStatus {
  pending_review
  applied
  discarded
  failed
}

enum AiExtractionStatus {
  pending
  completed
  failed
  skipped
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  sessions      Session[]
  subscription  Subscription?
  invites       OrganizationInvite[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  recurring     RecurringRule[]
  alertRules    AlertRule[]
  integrations  IntegrationConnection[]
  whatsappMessages WhatsappMessage[]
  smartDrafts   SmartDraft[]
  aiExtractions AiExtraction[]
  featureConfig OrganizationFeatureConfig?
  adminAuditLog AdminAuditLog[]
  usageMetrics  UsageMetric[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String?      @unique
  phone        String?      @unique
  name         String?
  passwordHash String
  passwordSalt String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
  invitesCreated  OrganizationInvite[] @relation("InvitesCreated")
  invitesAccepted OrganizationInvite[] @relation("InvitesAccepted")
  adminAuditLog   AdminAuditLog[]      @relation("AdminAuditActor")
  aiExtractions   AiExtraction[]       @relation("AiExtractionUser")
  usageMetrics    UsageMetric[]        @relation("UsageMetricUser")
}

model Membership {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  userId         String          @db.Uuid
  role           MembershipRole
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  tokenHash      String        @unique
  userId         String        @db.Uuid
  organizationId String        @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @db.Uuid
  plan               SubscriptionPlan
  status             SubscriptionStatus
  billingCycle       BillingCycle
  stripeCustomerId   String?            @unique
  stripeSubscriptionId String?          @unique
  stripePriceId      String?
  stripeSubscriptionCreatedAt DateTime?
  stripeLastEventCreatedAt DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id             String   @id
  type           String
  organizationId String?  @db.Uuid
  stripeCreatedAt DateTime?
  outcome        String   @default("processed")
  note           String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?
  attemptCount   Int      @default(0)

  @@index([organizationId, createdAt])
  @@index([processedAt])
}

model OrganizationInvite {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  invitedByUserId String          @db.Uuid
  email           String
  role            MembershipRole
  tokenHash       String          @unique
  expiresAt       DateTime?
  acceptedAt      DateTime?
  acceptedByUserId String?        @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User            @relation("InvitesCreated", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy      User?           @relation("InvitesAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([email])
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  name         String
  type         AccountType
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model Category {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  type           TransactionType
  color          String
  icon           String
  transactions   Transaction[]
  recurringRules RecurringRule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, type])
  @@index([organizationId, type])
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  name            String
  amount          Decimal         @db.Decimal(14, 2)
  type            TransactionType
  date            DateTime        @db.Date
  isFixed         Boolean         @default(false)
  isVariable      Boolean         @default(true)
  entityType      EntityType
  source          String
  categoryId      String          @db.Uuid
  accountId       String          @db.Uuid
  recurringRuleId String?         @db.Uuid
  notes           String?         @db.Text
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recurringRule   RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, entityType, date])
  @@index([organizationId, type, date])
  @@index([organizationId, source])
  @@index([organizationId, categoryId])
  @@index([organizationId, accountId])
  @@index([organizationId, recurringRuleId])
  @@unique([organizationId, recurringRuleId, date])
}

model RecurringRule {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  transactionName String
  amount          Decimal         @db.Decimal(14, 2)
  type            TransactionType
  entityType      EntityType
  source          String
  categoryId      String          @db.Uuid
  dayOfMonth      Int
  active          Boolean         @default(true)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, active])
  @@index([organizationId, entityType])
  @@index([organizationId, dayOfMonth])
}

model AlertRule {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  entityType      EntityType
  criticalPercent Int        @default(80)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([organizationId, entityType])
}

model OrganizationFeatureConfig {
  id                       String       @id @default(uuid()) @db.Uuid
  organizationId           String       @unique @db.Uuid
  whatsappEnabled          Boolean      @default(true)
  whatsappReceiveText      Boolean      @default(true)
  whatsappReceiveAudio     Boolean      @default(false)
  whatsappReceiveImage     Boolean      @default(false)
  openAiEnabled            Boolean      @default(true)
  openAiTextParsing        Boolean      @default(true)
  openAiAudioTranscription Boolean      @default(false)
  openAiImageUnderstanding Boolean      @default(false)
  autoReplyEnabled         Boolean      @default(false)
  memoryLongEnabled        Boolean      @default(false)
  multiAgentEnabled        Boolean      @default(false)
  manualReviewRequired     Boolean      @default(true)
  autoApprovalEnabled      Boolean      @default(false)
  monthlyCostLimitCents    Int          @default(0)
  updatedAt                DateTime     @updatedAt
  createdAt                DateTime     @default(now())
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  type                   IntegrationType
  status                 IntegrationStatus @default(active)
  whatsappPhoneNumberId  String?
  whatsappBusinessAccountId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappMessages       WhatsappMessage[]

  @@unique([organizationId, type])
  @@unique([whatsappPhoneNumberId])
  @@index([organizationId, createdAt])
  @@index([type, status])
}

model WhatsappMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  connectionId    String                  @db.Uuid
  externalId      String                  @unique
  direction       WhatsappMessageDirection
  messageType     WhatsappMessageType
  fromNumber      String?
  toNumber        String?
  textBody        String?
  mediaId         String?
  mediaMimeType   String?
  raw             Json
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection      IntegrationConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  smartDraft      SmartDraft?              @relation("MessageDraft")
  aiExtractions   AiExtraction[]

  @@index([organizationId, receivedAt])
  @@index([connectionId, receivedAt])
}

model SmartDraft {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  whatsappMessageId String?        @unique @db.Uuid
  status          SmartDraftStatus @default(pending_review)
  originalText    String?
  parsed          Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappMessage WhatsappMessage? @relation("MessageDraft", fields: [whatsappMessageId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
}

model AiExtraction {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  userId          String?            @db.Uuid
  whatsappMessageId String?          @db.Uuid
  status          AiExtractionStatus @default(pending)
  kind            String
  provider        String             @default("openai")
  model           String?
  input           Json
  output          Json?
  error           String?
  promptTokens    Int               @default(0)
  completionTokens Int              @default(0)
  costCents       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?             @relation("AiExtractionUser", fields: [userId], references: [id], onDelete: SetNull)
  whatsappMessage WhatsappMessage?  @relation(fields: [whatsappMessageId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([whatsappMessageId])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String?      @db.Uuid
  action         String
  data           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model UsageMetric {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  metricKey      String
  metricValue    Int          @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation("UsageMetricUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, metricKey, periodStart, periodEnd])
  @@index([organizationId, periodStart])
  @@index([metricKey, periodStart])
  @@index([userId, periodStart])
}
